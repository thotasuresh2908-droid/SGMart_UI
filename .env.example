# Copy to .env.local for local development (never commit it).

# Cloudflare Turnstile SITE key (public). Empty = no "I'm not a robot" check.
VITE_TURNSTILE_SITE_KEY=

# Local development only: which backend `npm run dev` forwards to.
# Default http://localhost:9001. To use the deployed backend instead:
VITE_DEV_BACKEND=https://sgmart-backend.onrender.com
# VITE_DEV_BACKEND=

# "off" when hosted as a Render static site (no WebSockets through its rewrites);
# screens then refresh every 15 seconds. Leave empty when the backend serves the web app.
VITE_LIVE_UPDATES=
